# The cohort-wide half of the configuration. Copied to .env.platform on first provision,
# which generates the passwords and the environment secret; the licence key is yours to
# paste in. Never committed -- workspace/.env* is gitignored.

# The image is private. Log in once per host before bringing anything up:
#   docker login docker.cloudsmith.io -u 'xillio/xill4' --password-stdin   <<< "$token"
# where the password is the Cloudsmith entitlement token.
XILL4_IMAGE_REPO=docker.cloudsmith.io/xillio/xill4/xill4
XILL4_VERSION=v4.62.0

# The uid the Xill4 image runs as, reported by `make preflight`. The provisioner hands the
# trainee's target/ directory to it; left empty, the directory is widened to 0777 instead.
XILL4_RUN_AS_UID=

# From the Xillio licence. Paste it here, not into the repository.
XILL4_LICENSE_KEY=

# Per-deployment, not per-trainee: one value shared by every instance in this cohort,
# generated once and then left alone. Changing it after trainees have started invalidates
# whatever the running instances encrypted with the old one.
XILL4_ENVIRONMENT_SECRET=

# The shared MongoDB. Root is used only by provision.sh to create per-trainee users;
# no Xill4 instance ever receives these credentials.
MONGO_IMAGE=mongo:7.0
MONGO_ROOT_USER=sandbox-root
MONGO_ROOT_PASSWORD=
MONGO_PORT=27017
