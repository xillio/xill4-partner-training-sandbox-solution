__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.workspaces/
workspace/.env

# Generated artifacts. Text worth reviewing is tracked; binaries and previews
# are not. A directory cannot be re-included once excluded, so the contents are
# ignored one level at a time rather than the folder as a whole.
artifacts/*
!artifacts/README.md
!artifacts/proposal/
!artifacts/deck/
artifacts/deck/*
!artifacts/deck/build.js
